# ── Required ────────────────────────────────────────────────────────────────
# Login credentials: comma-separated user:password pairs (yours + hers).
EDMISSIONS_USERS=tyler:change-me,friend:change-me-too

# Secret for signing session cookies. Any long random string:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
EDMISSIONS_SESSION_SECRET=

# ── Music (optional — player falls back to the local library without it) ────
# Free client id from https://devportal.jamendo.com (non-commercial tier).
EDMISSIONS_JAMENDO_CLIENT_ID=

# Folder of your own audio files; used when Jamendo is unavailable or unset.
# Default: data/music
#EDMISSIONS_MUSIC_DIR=data/music

# ── AI (optional — leave empty for the "lite" build, all AI controls hidden) ─
# OpenAI API key; enables research chat, note summaries, and campaign generation.
# The variable name intentionally matches the deployed server configuration.
EDMISSIONS_OPENAPI_KEY=

# ── Research advisor data (optional) ─────────────────────────────────────────
# Free key for the Census population and education figures the advisor uses.
# Without it, those figures are reported as unavailable.
# https://api.census.gov/data/key_signup.html
EDMISSIONS_CENSUS_KEY=

# Free BLS key for higher daily limits (500 a day instead of 25). Renew yearly.
# https://data.bls.gov/registrationEngine/
EDMISSIONS_BLS_KEY=

# Set to 1 only after SUNY Delhi approves sending Slate aggregates to OpenAI.
# It enables "Attach Slate table" in the research desk. Counts of 1 to 4 are hidden.
#EDMISSIONS_SLATE_AI_APPROVED=1

# ── Tuning (all optional) ────────────────────────────────────────────────────
# Port the server listens on. Default: 3000
#EDMISSIONS_PORT=3000

# Where the SQLite database lives. Default: data
#EDMISSIONS_DATA_DIR=data

# Minutes between RSS polls. Default: 20
#EDMISSIONS_FEED_POLL_MINUTES=20

# Set to 1 when running behind a reverse proxy (Caddy/nginx) so the login
# rate limiter sees real client IPs and cookies are marked Secure.
# docker-compose sets this automatically.
#EDMISSIONS_TRUST_PROXY=1

# Path to the content config (modes, feeds, keywords, subjects, template).
# Default: config/content.json — read at boot; restart to apply edits.
#EDMISSIONS_CONTENT_CONFIG=config/content.json
